{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@pink-logic/shared && npm run build --workspace=@pink-logic/api && node scripts/bundle-functions.mjs && npm run build --workspace=@pink-logic/web",
  "framework": "vite",
  "installCommand": "npm install",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{packages/api/dist/fonts/**,packages/api/dist/prompts/**,node_modules/harfbuzzjs/hb.wasm}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?__path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 9 * * *"
    }
  ]
}