{
  "description": "PINK-LOGIC v2 — máquina de conteúdo: API central + web + MCP para agentes (Athena)",
  "engines": {
    "node": "22.x"
  },
  "name": "pink-logic",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=@pink-logic/web",
    "dev:api": "npm run dev --workspace=@pink-logic/api",
    "dev:mcp": "npm run dev --workspace=@pink-logic/mcp",
    "install:all": "npm install"
  },
  "version": "2.0.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@vercel/nft": "^1.11.0",
    "@vercel/node": "^22.0.0"
  },
  "type": "module"
}
