and Kits (marcas) dos projetos da conta.","operationId":"listBrands","parameters":[{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"brands":{"items":{"$ref":"#/components/schemas/Brand"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar Brand Kits [NOVO]","tags":["brands"]},"post":{"description":"NOVO — só após deploy da branch. Cria uma marca (Brand Kit) num projeto: cores, fontes, tom, hashtags, logo.","operationId":"createBrand","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"brand":{"$ref":"#/components/schemas/Brand"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar um Brand Kit [NOVO]","tags":["brands"]}},"/api/brands/{id}":{"get":{"description":"NOVO — só após deploy da branch. Lê uma marca pelo id.","operationId":"getBrand","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"brand":{"$ref":"#/components/schemas/Brand"}},"type":"object"}}},"description":"OK"}},"summary":"Ler um Brand Kit [NOVO]","tags":["brands"]}},"/api/campaigns":{"get":{"description":"NOVO — só após deploy da branch. Lista as campanhas dos projetos da conta.","operationId":"listCampaigns","parameters":[{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"campaigns":{"items":{"$ref":"#/components/schemas/Campaign"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar campanhas [NOVO]","tags":["campaigns"]},"post":{"description":"NOVO — só após deploy da branch. Cria uma campanha num projeto: nome, produto, mensagem, objetivo.","operationId":"createCampaign","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CampaignCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"campaign":{"$ref":"#/components/schemas/Campaign"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar uma campanha [NOVO]","tags":["campaigns"]}},"/api/collect":{"post":{"description":"INDISPONÍVEL (11/11) — a recolha de tendências está desativada até existir uma integração real: o endpoint AIsa /v1/skills/fetch-trending não existe no contrato atual da AIsa. Não chamar esta operação.","operationId":"collectTrends","requestBody":{"content":{"application/json":{"schema":{"properties":{"limit":{"default":50,"maximum":500,"minimum":1,"type":"integer"},"query":{"description":"Handle, hashtag ou tópico","type":"string"},"source":{"enum":["instagram","tiktok","trends"],"type":"string"}},"required":["source","query"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"OK"}},"summary":"Coletar tendências (AIsa) [INDISPONÍVEL]","tags":["collect"]}},"/api/decide":{"post":{"description":"Pede ao Jev uma decisão calibrada (sim/não, escolha ou nota + confiança). Usa como porta antes de agendar. Sem chave, devolve passed=false (revisão humana).","operationId":"decide","requestBody":{"content":{"application/json":{"schema":{"properties":{"action":{"description":"Ex.: approve_post, score_caption","type":"string"},"context":{"description":"Estado a avaliar","type":"object"},"options":{"items":{"type":"string"},"type":"array"},"threshold":{"default":0.7,"maximum":1,"minimum":0,"type":"number"}},"required":["action","context"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"confidence":{"type":"number"},"passed":{"type":"boolean"},"provider":{"type":"string"},"value":{}},"type":"object"}}},"description":"OK"}},"summary":"Pedir uma decisão ao Jev","tags":["decide"]}},"/api/generate":{"post":{"description":"Geração: logo e sticker via Pollinations (grátis), QR via qrserver (grátis), copy e conteúdo de carrossel via AIsa, render de slide de carrossel e mockup no servidor. Escolhe o module conforme o pedido. Para carrossel/mockup, usa SEMPRE options.store=true: o PNG é guardado no Storage e a resposta traz imageUrl em vez de imageBase64 (base64 rebenta o limite de ~100K caracteres das Actions).","operationId":"generate","requestBody":{"content":{"application/json":{"schema":{"properties":{"brandId":{"format":"uuid","type":"string"},"module":{"enum":["logo","qrcode","sticker","story","copy","carousel","mockup"],"type":"string"},"options":{"description":"Por module: carousel content usa mode=content, topic, audience, tone, slideCount; render usa items, footer, handle, slideNumber e store=true (obrigatório); mockup usa mockupType, artworkUrl, projectName e store=true (obrigatório).","type":"object"},"prompt":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["module","prompt"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateResult"}}},"description":"OK"}},"summary":"Gerar conteúdo (logo, sticker, QR, copy, carrossel, mockup)","tags":["generate"]}},"/api/health":{"get":{"description":"Devolve ok, versão e que integrações estão ativas (jev, aisa). Pública, sem autenticação. Usa primeiro quando algo falhar.","operationId":"getHealth","responses":{"200":{"content":{"application/json":{"schema":{"properties":{"integrations":{"type":"object"},"ok":{"type":"boolean"},"service":{"type":"string"},"version":{"type":"string"}},"type":"object"}}},"description":"OK"}},"security":[],"summary":"Verificar se a API está viva","tags":["health"]}},"/api/media/import":{"post":{"description":"NOVO — só após deploy da branch. Descarrega uma imagem de uma URL pública (ex.: o link temporário que o ChatGPT entrega nas Actions) e guarda-a no Storage; devolve a URL pública para usar em mediaUrl. Só JPEG/PNG/WebP/GIF até 5 MB.","operationId":"importMedia","requestBody":{"content":{"application/json":{"schema":{"properties":{"filename":{"maxLength":100,"type":"string"},"url":{"format":"uri","maxLength":2000,"type":"string"}},"required":["url"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"contentType":{"type":"string"},"path":{"type":"string"},"sizeBytes":{"type":"integer"},"url":{"type":"string"}},"type":"object"}}},"description":"OK"}},"summary":"Importar uma imagem [NOVO]","tags":["media"]}},"/api/posts":{"get":{"description":"Lista rascunhos, agendados e publicados. Usa antes de criar ou agendar, para ver o que já existe.","operationId":"listPosts","parameters":[{"in":"query","name":"status","schema":{"enum":["rascunho","editando","agendado","publicando","publicado","falhou"],"type":"string"}},{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"from","schema":{"format":"date-time","type":"string"}},{"in":"query","name":"to","schema":{"format":"date-time","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"posts":{"items":{"$ref":"#/components/schemas/Post"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar posts","tags":["posts"]},"post":{"description":"Cria um post. Sem scheduledAt fica rascunho. Com scheduledAt, a chave do ChatGPT devolve 403 — agenda no site. Nunca publica.","operationId":"createPost","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar um post (rascunho)","tags":["posts"]}},"/api/posts/{id}":{"get":{"operationId":"getPost","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"OK"}},"summary":"Ler um post","tags":["posts"]},"patch":{"description":"Edita legenda, mídia, plataformas ou data. Passa só os campos a mudar.","operationId":"updatePost","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostUpdate"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"OK"}},"summary":"Editar um post","tags":["posts"]}}},"security":[{"ChatGPTKey":[]}],"servers":[{"description":"Preview da branch feat/chatgpt-gpt-actions-test (teste do GPT — nunca a produção)","url":"https://pink-logic-git-feat-chatgpt-gpt-b3d0d0-crissuboy-9102s-projects.vercel.app"}],"tags":[{"description":"Posts (rascunhos, agendados, publicados) — mesma tabela do site.","name":"posts"},{"description":"Brand Kits por projeto (cores, fontes, tom, logo).","name":"brands"},{"description":"Campanhas por projeto.","name":"campaigns"},{"description":"Import de imagens para o Storage.","name":"media"},{"description":"Geração: logo/sticker/QR grátis, copy via AIsa, carrossel/mockup.","name":"generate"},{"description":"Jev — decisão calibrada antes de agendar.","name":"decide"},{"description":"Coleta de tendências via AIsa.","name":"collect"},{"description":"Vida da API.","name":"health"}]}