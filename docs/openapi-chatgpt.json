ags":{"items":{"type":"string"},"type":"array"},"mediaUrl":{"description":"URL p\u00fablica da imagem. Para imagens geradas no ChatGPT, importar primeiro com importMedia.","format":"uri","type":"string"},"platforms":{"items":{"enum":["Instagram","Facebook","LinkedIn","X/Twitter","WordPress","Blog"],"type":"string"},"minItems":1,"type":"array"},"projectId":{"description":"Omitido = primeiro projeto da conta.","format":"uuid","type":"string"},"scheduledAt":{"description":"ISO 8601. A chave do ChatGPT N\u00c3O aceita data (403) \u2014 omitir, fica rascunho.","format":"date-time","type":"string"},"title":{"maxLength":200,"minLength":1,"type":"string"}},"required":["title","caption","platforms"],"type":"object"},"PostUpdate":{"properties":{"aspectRatio":{"type":"string"},"caption":{"maxLength":2200,"type":"string"},"hashtags":{"items":{"type":"string"},"type":"array"},"mediaUrl":{"format":"uri","type":"string"},"platforms":{"items":{"enum":["Instagram","Facebook","LinkedIn","X/Twitter","WordPress","Blog"],"type":"string"},"type":"array"},"scheduledAt":{"format":"date-time","type":"string"},"status":{"enum":["rascunho","editando","agendado","publicando","publicado","falhou"],"type":"string"},"title":{"maxLength":200,"minLength":1,"type":"string"}},"type":"object"}},"securitySchemes":{"ChatGPTKey":{"description":"Chave de servi\u00e7o do Pink Logic (PINK_LOGIC_CHATGPT_KEY). No editor do GPT: Authentication \u2192 API Key \u2192 Bearer. NUNCA partilhar o GPT \u2014 fica 'Only me'.","scheme":"bearer","type":"http"}}},"info":{"description":"API do Pink Logic (pink-logic.vercel.app) para um GPT privado do ChatGPT. A chave do GPT \u00e9 de permiss\u00f5es m\u00ednimas: cria rascunhos, l\u00ea, gera e importa \u2014 N\u00c3O agenda, N\u00c3O aprova, N\u00c3O publica e N\u00c3O apaga (tudo isso faz-se no site). Opera\u00e7\u00f5es marcadas NOVO s\u00f3 existem ap\u00f3s o deploy da branch feat/chatgpt-gpt-actions-test.","title":"Pink Logic API \u2014 ChatGPT Actions","version":"2.0.0"},"openapi":"3.1.0","paths":{"/api/brands":{"get":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. Lista os Brand Kits (marcas) dos projetos da conta.","operationId":"listBrands","parameters":[{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"brands":{"items":{"$ref":"#/components/schemas/Brand"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar Brand Kits [NOVO]","tags":["brands"]},"post":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. Cria uma marca (Brand Kit) num projeto: cores, fontes, tom, hashtags, logo.","operationId":"createBrand","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"brand":{"$ref":"#/components/schemas/Brand"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar um Brand Kit [NOVO]","tags":["brands"]}},"/api/brands/{id}":{"get":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. L\u00ea uma marca pelo id.","operationId":"getBrand","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"brand":{"$ref":"#/components/schemas/Brand"}},"type":"object"}}},"description":"OK"}},"summary":"Ler um Brand Kit [NOVO]","tags":["brands"]}},"/api/campaigns":{"get":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. Lista as campanhas dos projetos da conta.","operationId":"listCampaigns","parameters":[{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"campaigns":{"items":{"$ref":"#/components/schemas/Campaign"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar campanhas [NOVO]","tags":["campaigns"]},"post":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. Cria uma campanha num projeto: nome, produto, mensagem, objetivo.","operationId":"createCampaign","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CampaignCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"campaign":{"$ref":"#/components/schemas/Campaign"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar uma campanha [NOVO]","tags":["campaigns"]}},"/api/collect":{"post":{"description":"Coleta reels/posts/trends de um nicho via AIsa. Precisa de AISA_API_KEY configurada.","operationId":"collectTrends","requestBody":{"content":{"application/json":{"schema":{"properties":{"limit":{"default":50,"maximum":500,"minimum":1,"type":"integer"},"query":{"description":"Handle, hashtag ou t\u00f3pico","type":"string"},"source":{"enum":["instagram","tiktok","trends"],"type":"string"}},"required":["source","query"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"type":"object"}}},"description":"OK"}},"summary":"Coletar tend\u00eancias (AIsa)","tags":["collect"]}},"/api/decide":{"post":{"description":"Pede ao Jev uma decis\u00e3o calibrada (sim/n\u00e3o, escolha ou nota + confian\u00e7a). Usa como porta antes de agendar. Sem chave, devolve passed=false (revis\u00e3o humana).","operationId":"decide","requestBody":{"content":{"application/json":{"schema":{"properties":{"action":{"description":"Ex.: approve_post, score_caption","type":"string"},"context":{"description":"Estado a avaliar","type":"object"},"options":{"items":{"type":"string"},"type":"array"},"threshold":{"default":0.7,"maximum":1,"minimum":0,"type":"number"}},"required":["action","context"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"confidence":{"type":"number"},"passed":{"type":"boolean"},"provider":{"type":"string"},"value":{}},"type":"object"}}},"description":"OK"}},"summary":"Pedir uma decis\u00e3o ao Jev","tags":["decide"]}},"/api/generate":{"post":{"description":"Gera\u00e7\u00e3o: logo e sticker via Pollinations (gr\u00e1tis), QR via qrserver (gr\u00e1tis), copy e conte\u00fado de carrossel via AIsa, render de slide de carrossel e mockup no servidor. Escolhe o module conforme o pedido. Para carrossel/mockup, usa SEMPRE options.store=true: o PNG \u00e9 guardado no Storage e a resposta traz imageUrl em vez de imageBase64 (base64 rebenta o limite de ~100K caracteres das Actions).","operationId":"generate","requestBody":{"content":{"application/json":{"schema":{"properties":{"brandId":{"format":"uuid","type":"string"},"module":{"enum":["logo","qrcode","sticker","story","copy","carousel","mockup"],"type":"string"},"options":{"description":"Por module: carousel content usa mode=content, topic, audience, tone, slideCount; render usa items, footer, handle, slideNumber e store=true (obrigat\u00f3rio); mockup usa mockupType, artworkUrl, projectName e store=true (obrigat\u00f3rio).","type":"object"},"prompt":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["module","prompt"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateResult"}}},"description":"OK"}},"summary":"Gerar conte\u00fado (logo, sticker, QR, copy, carrossel, mockup)","tags":["generate"]}},"/api/health":{"get":{"description":"Devolve ok, vers\u00e3o e que integra\u00e7\u00f5es est\u00e3o ativas (jev, aisa). P\u00fablica, sem autentica\u00e7\u00e3o. Usa primeiro quando algo falhar.","operationId":"getHealth","responses":{"200":{"content":{"application/json":{"schema":{"properties":{"integrations":{"type":"object"},"ok":{"type":"boolean"},"service":{"type":"string"},"version":{"type":"string"}},"type":"object"}}},"description":"OK"}},"security":[],"summary":"Verificar se a API est\u00e1 viva","tags":["health"]}},"/api/media/import":{"post":{"description":"NOVO \u2014 s\u00f3 ap\u00f3s deploy da branch. Descarrega uma imagem de uma URL p\u00fablica (ex.: o link tempor\u00e1rio que o ChatGPT entrega nas Actions) e guarda-a no Storage; devolve a URL p\u00fablica para usar em mediaUrl. S\u00f3 JPEG/PNG/WebP/GIF at\u00e9 5 MB.","operationId":"importMedia","requestBody":{"content":{"application/json":{"schema":{"properties":{"filename":{"maxLength":100,"type":"string"},"url":{"format":"uri","maxLength":2000,"type":"string"}},"required":["url"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"contentType":{"type":"string"},"path":{"type":"string"},"sizeBytes":{"type":"integer"},"url":{"type":"string"}},"type":"object"}}},"description":"OK"}},"summary":"Importar uma imagem [NOVO]","tags":["media"]}},"/api/posts":{"get":{"description":"Lista rascunhos, agendados e publicados. Usa antes de criar ou agendar, para ver o que j\u00e1 existe.","operationId":"listPosts","parameters":[{"in":"query","name":"status","schema":{"enum":["rascunho","editando","agendado","publicando","publicado","falhou"],"type":"string"}},{"in":"query","name":"projectId","schema":{"format":"uuid","type":"string"}},{"in":"query","name":"from","schema":{"format":"date-time","type":"string"}},{"in":"query","name":"to","schema":{"format":"date-time","type":"string"}},{"in":"query","name":"limit","schema":{"default":50,"maximum":200,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"posts":{"items":{"$ref":"#/components/schemas/Post"},"type":"array"}},"type":"object"}}},"description":"OK"}},"summary":"Listar posts","tags":["posts"]},"post":{"description":"Cria um post. Sem scheduledAt fica rascunho. Com scheduledAt, a chave do ChatGPT devolve 403 \u2014 agenda no site. Nunca publica.","operationId":"createPost","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostCreate"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"Criado"}},"summary":"Criar um post (rascunho)","tags":["posts"]}},"/api/posts/{id}":{"get":{"operationId":"getPost","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"OK"}},"summary":"Ler um post","tags":["posts"]},"patch":{"description":"Edita legenda, m\u00eddia, plataformas ou data. Passa s\u00f3 os campos a mudar.","operationId":"updatePost","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostUpdate"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"post":{"$ref":"#/components/schemas/Post"}},"type":"object"}}},"description":"OK"}},"summary":"Editar um post","tags":["posts"]}}},"security":[{"ChatGPTKey":[]}],"servers":[{"description":"Preview da branch feat/chatgpt-gpt-actions-test (teste do GPT \u2014 nunca a produ\u00e7\u00e3o)","url":"https://pink-logic-git-feat-chatgpt-gpt-b3d0d0-crissuboy-9102s-projects.vercel.app"}],"tags":[{"description":"Posts (rascunhos, agendados, publicados) \u2014 mesma tabela do site.","name":"posts"},{"description":"Brand Kits por projeto (cores, fontes, tom, logo).","name":"brands"},{"description":"Campanhas por projeto.","name":"campaigns"},{"description":"Import de imagens para o Storage.","name":"media"},{"description":"Gera\u00e7\u00e3o: logo/sticker/QR gr\u00e1tis, copy via AIsa, carrossel/mockup.","name":"generate"},{"description":"Jev \u2014 decis\u00e3o calibrada antes de agendar.","name":"decide"},{"description":"Coleta de tend\u00eancias via AIsa.","name":"collect"},{"description":"Vida da API.","name":"health"}]}