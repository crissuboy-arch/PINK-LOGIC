# Configurações do PinkLogic

# Conexão com o Supabase (Fase 2)
# Deixe em branco para utilizar o fallback local (localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave da API OpenAI (para execução dos Agentes IA)
# Pode ser configurada aqui ou no painel de Execução
VITE_OPENAI_API_KEY=

# Nome da Aplicação
VITE_APP_NAME=PinkLogic
