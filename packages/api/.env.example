API_PORT=3002

# Supabase — leitura/escrita da API (service_role ignora RLS; nunca expor no cliente)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dono dos posts criados pela Athena/MCP (não há "utilizador logado" nesse caminho).
# UUID da sua conta: Supabase → Authentication → Users → copiar o ID ao lado do seu e-mail.
PINK_LOGIC_OWNER_USER_ID=

# Chave que a Athena/MCP envia no header Authorization para falar com esta API.
# Gere algo com pelo menos 32 caracteres aleatórios (ex.: openssl rand -hex 32).
PINK_LOGIC_SERVICE_KEY=

# Jev — decisão (opcional; sem chave = revisão humana sempre)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest

# AIsa — coleta + geração de texto/imagem (opcional)
AISA_API_URL=https://api.aisa.one
AISA_API_KEY=
AISA_MODEL=claude-opus-5

# Meta Graph API — publicação real no Instagram e no Facebook.
# O MESMO token de Página serve para as duas redes (Page Access Token com as
# permissões pages_manage_posts, pages_read_engagement, instagram_basic e
# instagram_content_publish). Sem isto configurado, publicar falha com um
# erro claro em vez de fingir sucesso.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# Protege GET /api/cron/publish (a Vercel envia este valor sozinha quando
# configurado — ver "crons" em vercel.json). Gere como o PINK_LOGIC_SERVICE_KEY.
CRON_SECRET=
